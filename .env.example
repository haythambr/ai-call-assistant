APP_NAME="AI Call Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- AI Call Assistant -------------------------------------------------

CALL_ASSISTANT_BUSINESS_NAME="Bright Smile Dental"
# Timezone used to understand "tomorrow at 10" and to book events.
CALL_ASSISTANT_TIMEZONE=UTC
CALL_ASSISTANT_DEFAULT_DURATION=30

# Shared secret for signing webhooks (X-Signature: sha256=<hmac of body>).
# install.sh fills this in with a random value.
CALL_WEBHOOK_SECRET=

# Leave empty to run in demo mode with built-in rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Outbound calls through Vapi (https://vapi.ai). Leave empty for demo calls.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
OUTBOUND_CALLING_HOURS_START=08:00
OUTBOUND_CALLING_HOURS_END=21:00
# Country code for CSV numbers written without +, e.g. 962 or 1. Empty = reject them.
OUTBOUND_DEFAULT_COUNTRY_CODE=

# Service account JSON key, and a calendar shared with that service account.
# Leave GOOGLE_CALENDAR_ID empty to record bookings in demo mode.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS=storage/app/private/google-service-account.json
